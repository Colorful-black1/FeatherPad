{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "轻羽 FeatherPad",
  "version": "0.1.0",
  "identifier": "app.featherpad.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "轻羽 FeatherPad",
        "width": 1200,
        "height": 800,
        "maximized": true,
        "decorations": false,
        "minWidth": 800,
        "minHeight": 560,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --disable-gpu --no-first-run --no-default-browser-check"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-QvJ9IQ7/oi1ZHPJRSmlkT0Wyo8apIf/Sd6qRgpw3Qjg='; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'self'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'sha256-QvJ9IQ7/oi1ZHPJRSmlkT0Wyo8apIf/Sd6qRgpw3Qjg='; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; frame-src 'self'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../packaging/LICENSE-TEXTS.txt": "packaging/LICENSE-TEXTS.txt",
      "../packaging/third-party-inventory.json": "packaging/third-party-inventory.json",
      "../docs/USER-GUIDE.md": "docs/USER-GUIDE.md",
      "../docs/RECOVERY.md": "docs/RECOVERY.md",
      "../docs/RELEASE-NOTES.md": "docs/RELEASE-NOTES.md"
    },
    "targets": [
      "nsis"
    ],
    "useLocalToolsDir": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
