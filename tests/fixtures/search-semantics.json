{
  "scope": "Shared search semantics for the documented safe subset; both the Rust regex crate and the local Web worker must return the same UTF-16 ranges.",
  "cases": [
    {
      "name": "literal case-insensitive",
      "pattern": "alpha",
      "text": "Alpha ALPHA alpha",
      "isRegex": false,
      "isCaseSensitive": false,
      "isWholeWord": false,
      "expected": [[0, 5], [6, 11], [12, 17]]
    },
    {
      "name": "Unicode whole word",
      "pattern": "中文",
      "text": "中文中文 中文",
      "isRegex": false,
      "isCaseSensitive": true,
      "isWholeWord": true,
      "expected": [[5, 7]]
    },
    {
      "name": "explicit UTF-16 selection range",
      "pattern": "cat",
      "text": "cat cat cat",
      "isRegex": false,
      "isCaseSensitive": true,
      "isWholeWord": false,
      "scope": [4, 7],
      "expected": [[4, 7]]
    },
    {
      "name": "noncapturing group with Unicode property and digit class",
      "pattern": "(?:\\p{L}+)-([0-9]+)",
      "text": "rune-42 中文-7",
      "isRegex": true,
      "isCaseSensitive": true,
      "isWholeWord": false,
      "expected": [[0, 7], [8, 12]]
    },
    {
      "name": "Rust-compatible named capture spelling",
      "pattern": "(?P<word>\\p{L}+)-([0-9]+)",
      "text": "rune-42 中文-7",
      "isRegex": true,
      "isCaseSensitive": true,
      "isWholeWord": false,
      "expected": [[0, 7], [8, 12]]
    },
    {
      "name": "multiline zero-width matches advance by Unicode scalar and stop at EOF",
      "pattern": "(?m)^|$",
      "text": "a\n文",
      "isRegex": true,
      "isCaseSensitive": true,
      "isWholeWord": false,
      "expected": [[0, 0], [1, 1], [2, 2], [3, 3]]
    },
    {
      "name": "Unicode property ranges map Rust bytes to UTF-16 offsets",
      "pattern": "\\p{L}+",
      "text": "A😀文",
      "isRegex": true,
      "isCaseSensitive": true,
      "isWholeWord": false,
      "expected": [[0, 1], [3, 4]]
    },
    {
      "name": "Unicode case-insensitive literal",
      "pattern": "ä",
      "text": "Ä ä",
      "isRegex": false,
      "isCaseSensitive": false,
      "isWholeWord": false,
      "expected": [[0, 1], [2, 3]]
    },
    {
      "name": "escaped regex metacharacter",
      "pattern": "a\\.b",
      "text": "a.b axb",
      "isRegex": true,
      "isCaseSensitive": true,
      "isWholeWord": false,
      "expected": [[0, 3]]
    }
  ]
}
